<?xml version="1.0" encoding="UTF-8"?>
<!--
    pom.xml = a "receita" do projeto para o Maven.
    Equivalente ao composer.json do Laravel: diz que bibliotecas o projeto usa.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Herdamos as configuracoes do Spring Boot: versoes compativeis entre si -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <!-- Identificacao do NOSSO projeto -->
    <groupId>org.nwh</groupId>
    <artifactId>crud-artigos</artifactId>
    <version>1.0.0</version>
    <name>crud-artigos</name>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Servidor web + controllers (como as rotas e controllers do Laravel) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Thymeleaf: paginas HTML geradas no servidor (como o Blade) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- JPA/Hibernate: guardar objetos Java na base de dados (como o Eloquent) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validacao de formularios: @NotBlank, @Min... (como as regras do Form Request) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- H2: base de dados em memoria. Perfeita para aprender: nao e preciso instalar nada.
             Os dados apagam-se quando a aplicacao para. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Recarrega a aplicacao automaticamente quando mudas o codigo -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Testes automaticos (JUnit 5 + MockMvc) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Permite correr com: mvn spring-boot:run -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
